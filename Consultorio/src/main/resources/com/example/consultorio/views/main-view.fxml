<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo.controllers.MainController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Directorio de Pacientes" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

        <TableView fx:id="tblPacientes" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCurp" text="CURP" prefWidth="100" />
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="250" />
                <TableColumn fx:id="colEstatus" text="Estatus" prefWidth="100" />
            </columns>
        </TableView>

        <HBox spacing="10.0">
            <children>
                <Button text="Agregar" onAction="#onNuevo" />
                <Button text="Editar" onAction="#onEditar" />
                <Button text="Cambiar Estatus" onAction="#onToggleStatus" />
            </children>
        </HBox>

        <Separator />

        <HBox spacing="20.0">
            <children>
                <Label fx:id="lblTotal" text="Total: 0" />
                <Label fx:id="lblActivos" text="Activos: 0" />
                <Label fx:id="lblInactivos" text="Inactivos: 0" />
            </children>
        </HBox>
    </children>
</VBox>