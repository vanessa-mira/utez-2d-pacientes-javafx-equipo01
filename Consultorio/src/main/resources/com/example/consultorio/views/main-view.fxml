<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="550.0" prefWidth="800.0" spacing="15.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.consultorio.controllers.MainController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Directorio de Pacientes - Consultorio">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <TableView fx:id="tblPacientes" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCurp" prefWidth="150.0" text="CURP" />
                <TableColumn fx:id="colNombre" prefWidth="350.0" text="Nombre Completo" />
                <TableColumn fx:id="colEstatus" prefWidth="120.0" text="Estatus" />
            </columns>
        </TableView>

        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Button onAction="#onOpenForm" style="-fx-background-color: #27ae60; -fx-text-fill: white;" text="Agregar paciente" />
                <Button onAction="#onToggleStatus" style="-fx-background-color: #e62249; -fx-text-fill: white;" text="Cambiar Estatus (Activo/Inactivo)" />
                <Button onAction="#onShowDetails" style="-fx-background-color: #707070; -fx-text-fill: white;" text="detalles" textFill="#2f81bc" />
            </children>
        </HBox>

        <Separator />

        <HBox spacing="40.0" style="-fx-background-color: #f4f4f4; -fx-padding: 10;">
            <children>
                <Label fx:id="lblTotal" text="Total: 0">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Label>
                <Label fx:id="lblActivos" text="Activos: 0" textFill="#27ae60">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Label>
                <Label fx:id="lblInactivos" text="Inactivos: 0" textFill="#c0392b">
                    <font><Font name="System Bold" size="14.0" /></font>
                </Label>
            </children>
        </HBox>
    </children>
</VBox>