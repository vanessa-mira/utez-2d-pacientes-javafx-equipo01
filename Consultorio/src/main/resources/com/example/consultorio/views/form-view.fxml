<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="450.0" spacing="20.0" style="-fx-background-color: #ffffff; -fx-border-color: #d1d1d1; -fx-border-width: 1;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.consultorio.controllers.FormController">
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
    </padding>
    <children>
        <Label text="Registro de Paciente" textFill="#333333">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>

        <Separator prefWidth="200.0" />

        <GridPane hgap="10.0" vgap="15.0">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="120.0" halignment="LEFT" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="250.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Label text="CURP:" />
                <TextField fx:id="txtCurp" promptText="Ingrese identificador" GridPane.columnIndex="1" />

                <Label text="Nombre Completo:" GridPane.rowIndex="1" />
                <TextField fx:id="txtNombre" promptText="Minimo 5 caracteres" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Edad:" GridPane.rowIndex="2" />
                <TextField fx:id="txtEdad" promptText="Solo numeros (0-120)" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Telefono:" GridPane.rowIndex="3" />
                <TextField fx:id="txtTel" promptText="10 digitos" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <Label text="Alergias:" GridPane.rowIndex="4" />
                <TextField fx:id="txtAlergias" promptText="Opcional" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            </children>
        </GridPane>

        <Separator prefWidth="200.0" />

        <Label fx:id="lblError" textFill="#b22222" wrapText="true">
            <font>
                <Font name="System Italic" size="12.0" />
            </font>
        </Label>

        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <children>
                <Button onAction="#onCancel" prefWidth="100.0" text="Cancelar" style="-fx-cursor: hand;" />
                <Button onAction="#onSave" prefWidth="120.0" text="Guardar" style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" />
            </children>
        </HBox>
    </children>
</VBox>


